# OmniSphere Runtime Configuration
PORT=3000
NODE_ENV=development

# Authentication
# Set a strong random secret in production (at least 32 chars).
# When omitted in development, an ephemeral in-memory secret is generated on startup.
JWT_SECRET=

# Demo mode enables the login demo-accounts panel and PA demo-data reset button.
DEMO_MODE=true

# Public base URL used for links in emails (password reset, alerts, approvals).
PUBLIC_BASE_URL=http://localhost:3000

# SQLite database path (used when server-side Firestore Admin SDK is unavailable).
DATABASE_PATH=./data/omnisphere.db

# Telemetry retention in days (default 90).
TELEMETRY_RETENTION_DAYS=90

# Optional SMTP settings for real email delivery.
# When omitted, OmniSphere runs in outbox-only mode (emails stored in Email Outbox).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@omnisphere.local
